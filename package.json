{
  "name": "coursera-rag",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "vitest run --reporter dot",
    "download-docs": "node ./scripts/fetch-angular-docs.js",
    "build-embeddings": "node ./server/build-vector-store.js",
    "docs:check": "node ./scripts/update-docs.js --check",
    "docs:update": "node ./scripts/update-docs.js",
    "start-backend": "node ./server/index.js"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@fastify/cors": "^9.0.0",
    "dotenv": "^16.6.1",
    "fastify": "^4.29.1",
    "openai": "^4.104.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}

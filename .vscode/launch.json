{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/"
    },
    {
      // The old "ng test" entry pointed at http://localhost:9876/debug.html,
      // which is Karma's debug URL. This workspace uses @angular/build:unit-test
      // with Vitest, so that URL never existed. Debug the backend instead.
      "name": "Debug backend (Fastify)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/index.js",
      "envFile": "${workspaceFolder}/.env",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}

  "contentHtml": "<div class=\"docs-decorative-header-container\">\n    <div class=\"docs-decorative-header\">\n      <div class=\"docs-header-content\">\n        \n\n        \n  <!-- Page title -->\n  <div class=\"docs-page-title\">\n    <h1 tabindex=\"-1\">Dependency injection in Angular</h1>\n    \n  </div>\n\n        <p><!-- markdownlint-disable-line -->\n\nDependency Injection (DI) is a design pattern you use to organize and share code across your application by supplying dependencies to a class instead of creating them inside it.</p>\n      </div>\n\n      <!-- illustration -->\n      <svg width=\"169\" height=\"218\" viewBox=\"0 0 169 218\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n  <path d=\"M15.9443 51.3052H94.1636\" stroke=\"#F637E3\" stroke-width=\"0.5\" stroke-miterlimit=\"10\"></path>\n  <path d=\"M15.9443 59.0986H94.1636\" stroke=\"#F637E3\" stroke-width=\"0.5\" stroke-miterlimit=\"10\"></path>\n  <path d=\"M15.9443 105.835H94.1636\" stroke=\"#F637E3\" stroke-width=\"0.5\" stroke-miterlimit=\"10\"></path>\n  <path d=\"M38.4619 66.8799H116.681\" stroke=\"#F637E3\" stroke-width=\"0.5\" stroke-miterlimit=\"10\"></path>\n  <path d=\"M38.4619 90.2607H116.681\" stroke=\"#F637E3\" stroke-width=\"0.5\" stroke-miterlimit=\"10\"></path>\n  <path d=\"M38.4619 98.042H116.681\" stroke=\"#E90464\" stroke-width=\"0.5\" stroke-miterlimit=\"10\"></path>\n  <path d=\"M56.6385 74.6736H134.858\" stroke=\"#8514F5\" stroke-width=\"0.5\" stroke-miterlimit=\"10\"></path>\n  <path d=\"M56.6385 82.467H134.858\" stroke=\"#8514F5\" stroke-width=\"0.5\" stroke-miterlimit=\"10\"></path>\n  <path d=\"M17.5722 97.8323H162.567C165.44 97.8323 167.758 100.163 167.758 103.024V184.153C167.758 187.027 165.428 189.345 162.567 189.345H17.5722C14.6989 189.345 12.3682 187.014 12.3682 184.141V103.012C12.3682 100.138 14.6989 97.8076 17.5722 97.8076V97.8323Z\" fill=\"white\"></path>\n  <path d=\"M162.567 98.1405C165.267 98.1405 167.462 100.336 167.462 103.036V184.166C167.462 186.866 1
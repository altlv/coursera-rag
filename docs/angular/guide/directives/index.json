  "contentHtml": "<div class=\"docs-decorative-header-container\">\n    <div class=\"docs-decorative-header\">\n      <div class=\"docs-header-content\">\n        \n\n        \n  <!-- Page title -->\n  <div class=\"docs-page-title\">\n    \n    \n  </div>\n\n        <p><!-- markdownlint-disable-line -->\nDirectives add behavior to elements and components in your Angular applications.</p>\n      </div>\n\n      <!-- illustration -->\n      <svg width=\"157\" height=\"288\" viewBox=\"0 0 157 288\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"docs-directives-svg\">\n  <g style=\"mix-blend-mode: multiply;\">\n    <path d=\"M64.7336 223.338H11.2638C8.32848 223.338 5.94891 225.718 5.94891 228.653V282.123C5.94891 285.058 8.32848 287.438 11.2638 287.438H64.7336C67.6689 287.438 70.0485 285.058 70.0485 282.123V228.653C70.0485 225.718 67.6689 223.338 64.7336 223.338Z\" fill=\"var(--senary-contrast)\"></path>\n  </g>\n  <path d=\"M74.9811 257.855V144.478\" stroke=\"#E90464\" stroke-width=\"0.5\" stroke-miterlimit=\"10\"></path>\n  <path d=\"M78.064 145.378L74.9811 140.051L71.9106 145.378H78.064Z\" fill=\"#E90464\"></path>\n  <path d=\"M90.8149 257.854V212.104H115.059\" stroke=\"var(--primary-contrast)\" stroke-width=\"0.5\" stroke-miterlimit=\"10\"></path>\n  <path d=\"M114.159 215.175L119.486 212.104L114.159 209.034V215.175Z\" fill=\"var(--primary-contrast)\"></path>\n  <path d=\"M57.6552 257.855V182.188H22.7569\" stroke=\"var(--primary-contrast)\" stroke-width=\"0.5\" stroke-miterlimit=\"10\"></path>\n  <path d=\"M23.6571 179.105L18.3298 182.1M113.098 50.6715C114.442 50.6715 115.527 51.7567 115.527 53.1008V120.024C115.527 121.368 114.442 122.454 113.098 122.454H46.1746C44.8304 122.454 43.7452 121.368 43.7452 120.024V53.1008C43.7452 51.7567 44.8304 50.6715 46.1746 50.6715H113.098ZM113.098 50.0549H46.1746C44.4975 50.0549 43.1287 51.4237 43.1287 53.1008V120.024C43.1287 121.701 44.4975 123.07 46.1746 123.07H113.098C114.775 123.07 116.144 121.701 116.144 120.024V53.1